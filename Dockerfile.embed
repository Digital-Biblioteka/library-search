FROM python:3.11-slim AS builder

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc g++ \
    && rm -rf /var/lib/apt/lists/*

COPY scripts/requirements.txt ./requirements.txt

RUN pip install --upgrade pip \
    && pip install --no-cache-dir --prefer-binary --user -r requirements.txt

FROM python:3.11-slim AS runtime

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /root/.local /root/.local

COPY scripts/embed_service.py ./scripts/embed_service.py

ENV PATH=/root/.local/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    EMBED_MODEL="sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2" \
    CROSS_ENCODER_MODEL="cross-encoder/ms-marco-MiniLM-L-6-v2" \
    TRANSFORMERS_CACHE=/root/.cache/huggingface \
    HF_HOME=/root/.cache/huggingface \
    TOKENIZERS_PARALLELISM=false

EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=5s --retries=10 --start-period=20m \
    CMD curl -fsS http://localhost:8000/healthz || exit 1

CMD ["uvicorn", "scripts.embed_service:app", "--host", "0.0.0.0", "--port", "8000", "--log-level", "warning"]